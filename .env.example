# ==============================================================================
# TestNexa AI — Frontend Environment Variables
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# All variables prefixed with VITE_ are embedded into the client-side JavaScript
# bundle at build time and are PUBLICLY READABLE by any user in their browser.
#
# NEVER put private API keys, database credentials, JWT secrets, or cloud secrets
# into this file or any frontend configuration. All sensitive operations must be
# executed server-side via the backend API.
# ==============================================================================

# Backend API URL (Development default: http://localhost:5000/api/v1)
# In production, set to your secure HTTPS API endpoint, e.g. https://api.testnexa.ai/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

