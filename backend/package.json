{
    "name": "testgen-ai-backend",
    "version": "1.0.0",
    "type": "commonjs",
    "description": "Backend API for TestGEN AI - AI-powered test case generation",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "node --watch-path=src src/server.js",
        "test": "node --test tests/playwright-configuration-modal.test.js tests/real-playwright-execution.test.js tests/test-run-creation.test.js tests/manual-execution.test.js",
        "postinstall": "npx playwright install chromium || true"
    },
    "keywords": [
        "test-generation",
        "ai",
        "qa",
        "testing"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@google/genai": "^1.38.0",
        "@google/generative-ai": "^0.24.1",
        "@supabase/supabase-js": "^2.116.0",
        "axios": "^1.2.1",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "express-session": "^1.19.0",
        "joi": "^17.7.0",
        "jsonwebtoken": "^9.0.3",
        "nodemailer": "^8.0.3",
        "passport": "^0.7.0",
        "passport-github2": "^0.1.12",
        "passport-google-oauth20": "^2.0.0",
        "playwright": "1.62.1",
        "pngjs": "^7.0.0"
    }
}
